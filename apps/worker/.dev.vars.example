# Generate two independent secrets, for example with `openssl rand -hex 32`.
ADMIN_TOKEN=
ATTEMPT_SECRET=
APP_ORIGIN=http://localhost:8787
# Optional NYCU login. Both credentials are required.
NYCU_CLIENT_ID=
NYCU_CLIENT_SECRET=

# Optional Google login through Firebase Authentication. Both settings are required.
# Enable Google in Firebase and register APP_ORIGIN/api/auth/google/callback on its Web OAuth client.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# Verified provider identities allowed to administer creation grants.
# Copy Google subjects from Myriad account information, not email addresses or Firebase UIDs.
ADMIN_IDENTITIES=[]

# Required only for problems with semanticCheck. Store production key with Wrangler secrets.
OPENAI_API_KEY=
OPENAI_SEMANTIC_MODEL=gpt-5.6-luna

# Optional PostHog analytics. The browser reaches PostHog through this Worker's /ingest proxy.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
