  "sampleCases": [
    {
      "input": "8\n-2 1 -3 4 -1 2 1 -5 4\n",
      "output": "6\n",
      "explanation": "The contiguous subarray [4, -1, 2, 1] has the largest sum = 6."
    },
    {
      "input": "5\n-1 -2 -3 -4 -5\n",
      "output": "-1\n",
      "explanation": "Single element [-1] has maximum sum -1."
    }
  ]
