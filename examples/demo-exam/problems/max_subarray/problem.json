        "14.in",
        "15.in"
      ]
    },
    {
      "name": "Subtask 4: All negative numbers (N <= 10,000)",
      "tests": [
        "16.in",
        "17.in",
        "18.in",
        "19.in",
        "20.in"
      ]
    },
    {
